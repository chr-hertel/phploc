{
    "name": "hertel/phploc",
    "description": "A tool for quickly measuring the size of a PHP project",
    "homepage": "https://github.com/chr-hertel/phploc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Sebastian Bergmann",
            "email": "sebastian@phpunit.de",
            "role": "Original author of PHPLOC"
        },
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de",
            "role": "Maintainer of this fork"
        }
    ],
    "support": {
        "issues": "https://github.com/chr-hertel/phploc/issues",
        "source": "https://github.com/chr-hertel/phploc"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "nikic/php-parser": "^5.8",
        "phpunit/php-file-iterator": "^7.0",
        "sebastian/complexity": "^6.0",
        "sebastian/lines-of-code": "^5.0",
        "sebastian/version": "^7.0",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Hertel\\PhpLoc\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/_helper/"
        ]
    },
    "bin": [
        "phploc"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "8.0-dev"
        }
    }
}
